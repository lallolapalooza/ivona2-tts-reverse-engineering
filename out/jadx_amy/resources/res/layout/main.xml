<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:src="@drawable/icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/textViewVoiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
            <TextView
                android:id="@+id/textViewVoiceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
            <TextView
                android:id="@+id/textViewVendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ivona_software"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/textViewStatus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voice_status_checking"/>
    <TextView
        android:id="@+id/textViewActivateVoice"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/textViewActivateVoice"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDescWithNext"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:id="@+id/textViewDescription"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/downloadInProgress"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">
            <Button
                android:id="@+id/buttonInstallIvonaTts"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buttonInstallIvonaTts"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/buttonActivateVoice"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/buttonActivateVoice"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDownloadCtrls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/percent0"/>
        <ProgressBar
            android:id="@+id/progressBarDownload"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvPercentAsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btResume"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_resume_download"
            style="?android:attr/buttonStyleSmall"/>
        <Button
            android:id="@+id/btPause"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_pause_download"
            style="?android:attr/buttonStyleSmall"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llApproveCellular"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/textPausedParagraph1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/text_paused_cellular"/>
        <TextView
            android:id="@+id/textPausedParagraph2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/text_paused_cellular_2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:layout_gravity="center"
                android:id="@+id/btResumeOverCellular"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/text_button_resume_cellular"
                android:layout_weight="1"/>
            <Button
                android:layout_gravity="center"
                android:id="@+id/btWifiSettingsButton"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/text_button_wifi_settings"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/textViewFAQLink"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"/>
</LinearLayout>
